# Copia este contenido en el .env del stack en OMV (Regalos3D.env). NUNCA lo subas a GitHub.

# --- Base de datos (opción A: MariaDB del host) ---
DB_URL=jdbc:mariadb://IP-DEL-SERVIDOR:3306/regalos_db
DB_USER=regalos
DB_PASSWORD=CAMBIAR_contraseña_larga_y_aleatoria
# DB_ROOT_PASSWORD=solo_si_usas_la_opcion_B

# --- Acceso a la app ---
ADMIN_USER=admin
# Hash bcrypt (ver README). Entre comillas SIMPLES para que Compose no interprete los $
ADMIN_PASSWORD_HASH='$2y$12$CAMBIAR_POR_TU_HASH'

# Las tarifas (bobina, luz, mano de obra, amortización, margen) se cambian en la pantalla Ajustes

MANYFOLD_URL=http://IP-DEL-SERVIDOR:3214
