# Copia este archivo como .env en esta misma carpeta y rellénalo. El .env NUNCA va al repositorio.

# Contraseñas de la base de datos real (inventa dos largas y distintas).
# Solo se usan al crear la base: si las cambias después, no se actualizan solas.
DB_PASSWORD='CAMBIAR_contraseña_larga'
DB_ROOT_PASSWORD='CAMBIAR_otra_contraseña_larga'

# Usuario de la app y hash bcrypt de su contraseña:
#   htpasswd -nbBC 12 "" 'tu-contraseña' | tr -d ':\n'; echo
# Entre comillas SIMPLES para que no se interpreten los $
ADMIN_USER='carlos'
ADMIN_PASSWORD_HASH='$2y$12$CAMBIAR_POR_TU_HASH'
